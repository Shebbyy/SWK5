<Window x:Class="Swack.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:Swack.Logic.Models;assembly=Swack.Logic"
        xmlns:controls="clr-namespace:Swack.UI.Controls"
        xmlns:converters="clr-namespace:Swack.UI.Converters"
        xmlns:local="clr-namespace:Swack.UI"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Window.Resources>

        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>

        <DataTemplate DataType="{x:Type models:Message}">
            <DockPanel Margin="0,0,0,20" LastChildFill="True">

                <Image DockPanel.Dock="Left"
                VerticalAlignment="Top" Margin="0,0,5,0"
                Width="50" Height="50"
                Source="{Binding User.ProfileUrl}"/>

                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                    <TextBlock FontWeight="Bold" Text="{Binding User.Username}"/>
                    <TextBlock FontSize="10" Foreground="Gray" Margin="5,0,0,0" Text="{Binding Timestamp, StringFormat=g}"/>
                </StackPanel>

                <TextBlock VerticalAlignment="Top" TextWrapping="Wrap" Text="{Binding Text}"/>

            </DockPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type models:ImageMessage}">
            <DockPanel Margin="0,0,0,20" LastChildFill="True">

                <Image DockPanel.Dock="Left"
                VerticalAlignment="Top" Margin="0,0,5,0"
                Width="50" Height="50"
                Source="{Binding User.ProfileUrl}"/>

                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                    <TextBlock FontWeight="Bold" Text="{Binding User.Username}"/>
                    <TextBlock FontSize="10" Foreground="Gray" Margin="5,0,0,0" Text="{Binding Timestamp, StringFormat=g}"/>
                </StackPanel>

                <Image MaxHeight="300" HorizontalAlignment="Left" Source="{Binding ImageUrl}"/>

            </DockPanel>
        </DataTemplate>
    </Window.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <ListBox Grid.Column="0" BorderThickness="0"
                 ItemsSource="{Binding Channels}" 
                 SelectedItem="{Binding CurrentChannel}">
            <ListBox.ItemTemplate>
                <DataTemplate>

                    <StackPanel Orientation="Horizontal" Margin="0,6">
                        <TextBlock Text="{Binding Channel.Name}" FontSize="18" FontWeight="Bold"/>
                        <Border x:Name="badge" Background="DarkRed" CornerRadius="10" Padding="8,0" Margin="5,0,0,0">
                            <TextBlock VerticalAlignment="Center" Foreground="White" Text="{Binding UnreadMessages}"></TextBlock>
                        </Border>
                    </StackPanel>

                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding UnreadMessages}" Value="0">
                            <Setter TargetName="badge" Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>

                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <GridSplitter Grid.Column="0" VerticalAlignment="Stretch" HorizontalAlignment="Right"
                      Background="DarkGray" Width="2"/>

        <DockPanel Grid.Column="1" Margin="25,0,0,0" DataContext="{Binding CurrentChannel}" LastChildFill="True">
            
            <TextBlock DockPanel.Dock="Top"
                       FontSize="30" Margin="0,10,0,5"
                       Text="{Binding Channel.Name}"></TextBlock>

            <controls:SendMessageControl DockPanel.Dock="Bottom" Margin="0,30,15,15"/>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Messages}">
                </ItemsControl>
            </ScrollViewer>

            <DockPanel.InputBindings>
                <KeyBinding Key="Return" Command="{Binding SendMessageCommand}"/>
            </DockPanel.InputBindings>

        </DockPanel>

        <Border Grid.Column="1" Background="White" Margin="0" CornerRadius="0" BorderThickness="0" Visibility="{Binding CurrentChannel, Converter={StaticResource NullToVisibilityConverter}}">
            <TextBlock Text="Please select a channel" Foreground="Gray" FontSize="30" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Border>

    </Grid>
</Window>   
